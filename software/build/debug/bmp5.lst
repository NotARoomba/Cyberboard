1481:Drivers/BMP580/bmp5.c ****         {
1482:Drivers/BMP580/bmp5.c ****             rslt = bmp5_get_interrupt_status(&por_status, dev);
1483:Drivers/BMP580/bmp5.c **** 
1484:Drivers/BMP580/bmp5.c ****             if (rslt == BMP5_OK)
1485:Drivers/BMP580/bmp5.c ****             {
1486:Drivers/BMP580/bmp5.c ****                 /* Check if por/soft-reset complete status = 1 to proceed */
1487:Drivers/BMP580/bmp5.c ****                 if (por_status & BMP5_INT_ASSERTED_POR_SOFTRESET_COMPLETE)
1488:Drivers/BMP580/bmp5.c ****                 {
1489:Drivers/BMP580/bmp5.c ****                     rslt = BMP5_OK;
1490:Drivers/BMP580/bmp5.c ****                 }
1491:Drivers/BMP580/bmp5.c ****                 else
1492:Drivers/BMP580/bmp5.c ****                 {
1493:Drivers/BMP580/bmp5.c ****                     rslt = BMP5_E_POWER_UP;
1494:Drivers/BMP580/bmp5.c ****                 }
1495:Drivers/BMP580/bmp5.c ****             }
1496:Drivers/BMP580/bmp5.c ****         }
1497:Drivers/BMP580/bmp5.c ****         else
1498:Drivers/BMP580/bmp5.c ****         {
1499:Drivers/BMP580/bmp5.c ****             rslt = BMP5_E_POWER_UP;
1500:Drivers/BMP580/bmp5.c ****         }
1501:Drivers/BMP580/bmp5.c ****     }
1502:Drivers/BMP580/bmp5.c **** 
1503:Drivers/BMP580/bmp5.c ****     return rslt;
1504:Drivers/BMP580/bmp5.c **** }
