2034:Drivers/BMP580/bmp5.c **** /*!
2035:Drivers/BMP580/bmp5.c ****  * @brief This internal API is used to set the nvm address and prog_enable based on NVM read/write 
2036:Drivers/BMP580/bmp5.c ****  */
2037:Drivers/BMP580/bmp5.c **** static int8_t set_nvm_addr(uint8_t nvm_addr, uint8_t prog_en, struct bmp5_dev *dev)
2038:Drivers/BMP580/bmp5.c **** {
2039:Drivers/BMP580/bmp5.c ****     int8_t rslt;
