2063:Drivers/BMP580/bmp5.c ****                 reg_data = BMP5_SET_BIT_VAL_0(reg_data, BMP5_NVM_PROG_EN);
2064:Drivers/BMP580/bmp5.c ****             }
2065:Drivers/BMP580/bmp5.c **** 
2066:Drivers/BMP580/bmp5.c ****             rslt = bmp5_set_regs(BMP5_REG_NVM_ADDR, &reg_data, 1, dev);
2067:Drivers/BMP580/bmp5.c ****         }
2068:Drivers/BMP580/bmp5.c ****     }
2069:Drivers/BMP580/bmp5.c ****     else
2070:Drivers/BMP580/bmp5.c ****     {
2071:Drivers/BMP580/bmp5.c ****         rslt = BMP5_E_NVM_NOT_READY;
2072:Drivers/BMP580/bmp5.c ****     }
2073:Drivers/BMP580/bmp5.c **** 
2074:Drivers/BMP580/bmp5.c ****     return rslt;
