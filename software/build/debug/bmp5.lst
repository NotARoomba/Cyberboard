1578:Drivers/BMP580/bmp5.c ****         }
1579:Drivers/BMP580/bmp5.c **** 
1580:Drivers/BMP580/bmp5.c ****         if (rslt == BMP5_OK)
1581:Drivers/BMP580/bmp5.c ****         {
1582:Drivers/BMP580/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_FIFO_SEL, &reg_data, 1, dev);
1583:Drivers/BMP580/bmp5.c **** 
1584:Drivers/BMP580/bmp5.c ****             if (rslt == BMP5_OK)
1585:Drivers/BMP580/bmp5.c ****             {
1586:Drivers/BMP580/bmp5.c ****                 /* Disable fifo frame selct */
1587:Drivers/BMP580/bmp5.c ****                 reg_data = BMP5_SET_BIT_VAL_0(reg_data, BMP5_FIFO_FRAME_SEL);
1588:Drivers/BMP580/bmp5.c **** 
