 708:Drivers/BMP580/bmp5.c **** {
 709:Drivers/BMP580/bmp5.c ****     /* Variable to store the function result */
 710:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 711:Drivers/BMP580/bmp5.c **** 
 712:Drivers/BMP580/bmp5.c ****     /* Variable to get interrupt configuration */
 713:Drivers/BMP580/bmp5.c ****     uint8_t reg_data = 0;
 714:Drivers/BMP580/bmp5.c **** 
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\ccGCFMYR.s 			page 14


 715:Drivers/BMP580/bmp5.c ****     /* Variable to set interrupt source */
 716:Drivers/BMP580/bmp5.c ****     uint8_t int_source = 0;
 717:Drivers/BMP580/bmp5.c **** 
 718:Drivers/BMP580/bmp5.c ****     /* Variable to get interrupt status */
 719:Drivers/BMP580/bmp5.c ****     uint8_t int_status = 0;
 720:Drivers/BMP580/bmp5.c **** 
 721:Drivers/BMP580/bmp5.c ****     /* Get interrupt configuration */
 722:Drivers/BMP580/bmp5.c ****     rslt = bmp5_get_regs(BMP5_REG_INT_CONFIG, &reg_data, 1, dev);
 723:Drivers/BMP580/bmp5.c **** 
 724:Drivers/BMP580/bmp5.c ****     if (rslt == BMP5_OK)
 725:Drivers/BMP580/bmp5.c ****     {
 726:Drivers/BMP580/bmp5.c ****         /* Any change between latched/pulsed mode has to be applied while interrupt is disabled */
 727:Drivers/BMP580/bmp5.c ****         /* Step 1 : Turn off all INT sources (INT_SOURCE -> 0x00) */
 728:Drivers/BMP580/bmp5.c ****         rslt = bmp5_set_regs(BMP5_REG_INT_SOURCE, &int_source, 1, dev);
 729:Drivers/BMP580/bmp5.c **** 
 730:Drivers/BMP580/bmp5.c ****         if (rslt == BMP5_OK)
 731:Drivers/BMP580/bmp5.c ****         {
 732:Drivers/BMP580/bmp5.c ****             /* Step 2 : Read the INT_STATUS register to clear the status */
 733:Drivers/BMP580/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_INT_STATUS, &int_status, 1, dev);
 734:Drivers/BMP580/bmp5.c **** 
 735:Drivers/BMP580/bmp5.c ****             if (rslt == BMP5_OK)
 736:Drivers/BMP580/bmp5.c ****             {
 737:Drivers/BMP580/bmp5.c ****                 /* Step 3 : Set the desired mode in INT_CONFIG.int_mode */
 738:Drivers/BMP580/bmp5.c ****                 reg_data = BMP5_SET_BITS_POS_0(reg_data, BMP5_INT_MODE, int_mode);
 739:Drivers/BMP580/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_INT_POL, int_pol);
 740:Drivers/BMP580/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_INT_OD, int_od);
 741:Drivers/BMP580/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_INT_EN, int_en);
 742:Drivers/BMP580/bmp5.c **** 
 743:Drivers/BMP580/bmp5.c ****                 /* Finally transfer the interrupt configurations */
 744:Drivers/BMP580/bmp5.c ****                 rslt = bmp5_set_regs(BMP5_REG_INT_CONFIG, &reg_data, 1, dev);
 745:Drivers/BMP580/bmp5.c ****             }
 746:Drivers/BMP580/bmp5.c ****         }
 747:Drivers/BMP580/bmp5.c ****     }
 748:Drivers/BMP580/bmp5.c **** 
 749:Drivers/BMP580/bmp5.c ****     return rslt;
 750:Drivers/BMP580/bmp5.c **** }
