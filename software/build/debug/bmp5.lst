1541:Drivers/BMP580/bmp5.c **** /*!
1542:Drivers/BMP580/bmp5.c ****  * @brief This internal API is used to set sensor in deep standby mode.
1543:Drivers/BMP580/bmp5.c ****  */
1544:Drivers/BMP580/bmp5.c **** static int8_t set_deep_standby_mode(struct bmp5_dev *dev)
