 283:Drivers/BMP580/bmp5.c **** /*!
 284:Drivers/BMP580/bmp5.c **** *  @brief This API is the entry point.
 285:Drivers/BMP580/bmp5.c **** *  It performs the selection of I2C/I3C/SPI read mechanism according to the
 286:Drivers/BMP580/bmp5.c **** *  selected interface and reads the chip-id of the sensor.
 287:Drivers/BMP580/bmp5.c **** */
 288:Drivers/BMP580/bmp5.c **** int8_t bmp5_init(struct bmp5_dev *dev)
 289:Drivers/BMP580/bmp5.c **** {
 290:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 291:Drivers/BMP580/bmp5.c ****     uint8_t reg_data;
 292:Drivers/BMP580/bmp5.c ****     uint8_t chip_id;
 293:Drivers/BMP580/bmp5.c **** 
 294:Drivers/BMP580/bmp5.c ****     /* Check for null pointer in the device structure */
 295:Drivers/BMP580/bmp5.c ****     rslt = null_ptr_check(dev);
 296:Drivers/BMP580/bmp5.c **** 
 297:Drivers/BMP580/bmp5.c ****     if (rslt == BMP5_OK)
 298:Drivers/BMP580/bmp5.c ****     {
 299:Drivers/BMP580/bmp5.c ****         dev->chip_id = 0;
 300:Drivers/BMP580/bmp5.c **** 
 301:Drivers/BMP580/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 302:Drivers/BMP580/bmp5.c ****         {
 303:Drivers/BMP580/bmp5.c ****             /* Performing a single read via SPI of registers,
 304:Drivers/BMP580/bmp5.c ****              * e.g. registers CHIP_ID, before the actual
 305:Drivers/BMP580/bmp5.c ****              * SPI communication with the device.
 306:Drivers/BMP580/bmp5.c ****              */
 307:Drivers/BMP580/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_CHIP_ID, &reg_data, 1, dev);
 308:Drivers/BMP580/bmp5.c ****         }
 309:Drivers/BMP580/bmp5.c **** 
 310:Drivers/BMP580/bmp5.c ****         if (rslt == BMP5_OK)
 311:Drivers/BMP580/bmp5.c ****         {
 312:Drivers/BMP580/bmp5.c ****             /* Read chip_id */
 313:Drivers/BMP580/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_CHIP_ID, &chip_id, 1, dev);
 314:Drivers/BMP580/bmp5.c **** 
 315:Drivers/BMP580/bmp5.c ****             if (rslt == BMP5_OK)
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\ccGCFMYR.s 			page 7


 316:Drivers/BMP580/bmp5.c ****             {
 317:Drivers/BMP580/bmp5.c ****                 if (chip_id != 0)
 318:Drivers/BMP580/bmp5.c ****                 {
 319:Drivers/BMP580/bmp5.c ****                     /* Validate post power-up procedure */
 320:Drivers/BMP580/bmp5.c ****                     rslt = power_up_check(dev);
 321:Drivers/BMP580/bmp5.c ****                 }
 322:Drivers/BMP580/bmp5.c ****                 else
 323:Drivers/BMP580/bmp5.c ****                 {
 324:Drivers/BMP580/bmp5.c ****                     rslt = BMP5_E_INVALID_CHIP_ID;
 325:Drivers/BMP580/bmp5.c ****                 }
 326:Drivers/BMP580/bmp5.c **** 
 327:Drivers/BMP580/bmp5.c ****                 if (rslt == BMP5_OK)
 328:Drivers/BMP580/bmp5.c ****                 {
 329:Drivers/BMP580/bmp5.c ****                     rslt = validate_chip_id(chip_id, dev);
 330:Drivers/BMP580/bmp5.c ****                 }
 331:Drivers/BMP580/bmp5.c ****             }
 332:Drivers/BMP580/bmp5.c ****         }
 333:Drivers/BMP580/bmp5.c ****     }
 334:Drivers/BMP580/bmp5.c **** 
 335:Drivers/BMP580/bmp5.c ****     return rslt;
 336:Drivers/BMP580/bmp5.c **** }
 337:Drivers/BMP580/bmp5.c **** 
 338:Drivers/BMP580/bmp5.c **** /*!
 339:Drivers/BMP580/bmp5.c ****  * @brief This API reads the data from the given register address of the sensor.
 340:Drivers/BMP580/bmp5.c ****  */
 341:Drivers/BMP580/bmp5.c **** int8_t bmp5_get_regs(uint8_t reg_addr, uint8_t *reg_data, uint32_t len, struct bmp5_dev *dev)
 342:Drivers/BMP580/bmp5.c **** {
 343:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 344:Drivers/BMP580/bmp5.c **** 
 345:Drivers/BMP580/bmp5.c ****     /* Check for null pointer in the device structure */
 346:Drivers/BMP580/bmp5.c ****     rslt = null_ptr_check(dev);
 347:Drivers/BMP580/bmp5.c **** 
 348:Drivers/BMP580/bmp5.c ****     /* Proceed if null check is fine */
 349:Drivers/BMP580/bmp5.c ****     if ((rslt == BMP5_OK) && (reg_data != NULL))
 350:Drivers/BMP580/bmp5.c ****     {
 351:Drivers/BMP580/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 352:Drivers/BMP580/bmp5.c ****         {
 353:Drivers/BMP580/bmp5.c ****             /* If interface selected is SPI */
 354:Drivers/BMP580/bmp5.c ****             reg_addr = reg_addr | BMP5_SPI_RD_MASK;
 355:Drivers/BMP580/bmp5.c ****         }
 356:Drivers/BMP580/bmp5.c **** 
 357:Drivers/BMP580/bmp5.c ****         /* Read the data from the reg_addr */
 358:Drivers/BMP580/bmp5.c ****         dev->intf_rslt = dev->read(reg_addr, reg_data, len, dev->intf_ptr);
 359:Drivers/BMP580/bmp5.c **** 
 360:Drivers/BMP580/bmp5.c ****         if (dev->intf_rslt != BMP5_INTF_RET_SUCCESS)
 361:Drivers/BMP580/bmp5.c ****         {
 362:Drivers/BMP580/bmp5.c ****             /* Failure case */
 363:Drivers/BMP580/bmp5.c ****             rslt = BMP5_E_COM_FAIL;
 364:Drivers/BMP580/bmp5.c ****         }
 365:Drivers/BMP580/bmp5.c ****     }
 366:Drivers/BMP580/bmp5.c ****     else
 367:Drivers/BMP580/bmp5.c ****     {
 368:Drivers/BMP580/bmp5.c ****         rslt = BMP5_E_NULL_PTR;
 369:Drivers/BMP580/bmp5.c ****     }
 370:Drivers/BMP580/bmp5.c **** 
 371:Drivers/BMP580/bmp5.c ****     return rslt;
 372:Drivers/BMP580/bmp5.c **** }
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\ccGCFMYR.s 			page 8


 373:Drivers/BMP580/bmp5.c **** 
 374:Drivers/BMP580/bmp5.c **** /*!
 375:Drivers/BMP580/bmp5.c ****  * @brief This API writes the given data to the register address
 376:Drivers/BMP580/bmp5.c ****  * of the sensor.
 377:Drivers/BMP580/bmp5.c ****  */
 378:Drivers/BMP580/bmp5.c **** int8_t bmp5_set_regs(uint8_t reg_addr, const uint8_t *reg_data, uint32_t len, struct bmp5_dev *dev)
 379:Drivers/BMP580/bmp5.c **** {
 380:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 381:Drivers/BMP580/bmp5.c ****     uint8_t idx = 0;
 382:Drivers/BMP580/bmp5.c **** 
 383:Drivers/BMP580/bmp5.c ****     /* Check for null pointer in the device structure */
 384:Drivers/BMP580/bmp5.c ****     rslt = null_ptr_check(dev);
 385:Drivers/BMP580/bmp5.c **** 
 386:Drivers/BMP580/bmp5.c ****     /* Proceed if null check is fine */
 387:Drivers/BMP580/bmp5.c ****     if ((rslt == BMP5_OK) && (reg_data != NULL))
 388:Drivers/BMP580/bmp5.c ****     {
 389:Drivers/BMP580/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 390:Drivers/BMP580/bmp5.c ****         {
 391:Drivers/BMP580/bmp5.c ****             /* Write the data to the reg_addr */
 392:Drivers/BMP580/bmp5.c ****             do
 393:Drivers/BMP580/bmp5.c ****             {
 394:Drivers/BMP580/bmp5.c ****                 dev->intf_rslt = dev->write((reg_addr + idx), &reg_data[idx], 1, dev->intf_ptr);
 395:Drivers/BMP580/bmp5.c ****                 idx++;
 396:Drivers/BMP580/bmp5.c ****             } while ((idx < len) && (dev->intf_rslt == BMP5_INTF_RET_SUCCESS));
 397:Drivers/BMP580/bmp5.c ****         }
 398:Drivers/BMP580/bmp5.c ****         else if ((dev->intf == BMP5_I2C_INTF) || (dev->intf == BMP5_I3C_INTF))
 399:Drivers/BMP580/bmp5.c ****         {
 400:Drivers/BMP580/bmp5.c ****             /* Write the data to the reg_addr */
 401:Drivers/BMP580/bmp5.c ****             dev->intf_rslt = dev->write(reg_addr, reg_data, len, dev->intf_ptr);
 402:Drivers/BMP580/bmp5.c ****         }
 403:Drivers/BMP580/bmp5.c **** 
 404:Drivers/BMP580/bmp5.c ****         if (dev->intf_rslt != BMP5_INTF_RET_SUCCESS)
 405:Drivers/BMP580/bmp5.c ****         {
 406:Drivers/BMP580/bmp5.c ****             /* Failure case */
 407:Drivers/BMP580/bmp5.c ****             rslt = BMP5_E_COM_FAIL;
 408:Drivers/BMP580/bmp5.c ****         }
 409:Drivers/BMP580/bmp5.c ****     }
 410:Drivers/BMP580/bmp5.c ****     else
 411:Drivers/BMP580/bmp5.c ****     {
 412:Drivers/BMP580/bmp5.c ****         rslt = BMP5_E_NULL_PTR;
 413:Drivers/BMP580/bmp5.c ****     }
 414:Drivers/BMP580/bmp5.c **** 
 415:Drivers/BMP580/bmp5.c ****     return rslt;
 416:Drivers/BMP580/bmp5.c **** }
 417:Drivers/BMP580/bmp5.c **** 
 418:Drivers/BMP580/bmp5.c **** /*!
 419:Drivers/BMP580/bmp5.c ****  * @brief This API performs the soft reset of the sensor.
 420:Drivers/BMP580/bmp5.c ****  */
 421:Drivers/BMP580/bmp5.c **** int8_t bmp5_soft_reset(struct bmp5_dev *dev)
 422:Drivers/BMP580/bmp5.c **** {
 423:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 424:Drivers/BMP580/bmp5.c ****     uint8_t reg_data;
 425:Drivers/BMP580/bmp5.c ****     uint8_t por_status;
 426:Drivers/BMP580/bmp5.c ****     uint8_t data = BMP5_SOFT_RESET_CMD;
 427:Drivers/BMP580/bmp5.c **** 
 428:Drivers/BMP580/bmp5.c ****     /* Reset the device */
 429:Drivers/BMP580/bmp5.c ****     rslt = bmp5_set_regs(BMP5_REG_CMD, &data, 1, dev);
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\ccGCFMYR.s 			page 9


 430:Drivers/BMP580/bmp5.c **** 
 431:Drivers/BMP580/bmp5.c ****     if (rslt == BMP5_OK)
 432:Drivers/BMP580/bmp5.c ****     {
 433:Drivers/BMP580/bmp5.c ****         /* Soft-reset execution takes 2 ms */
 434:Drivers/BMP580/bmp5.c ****         dev->delay_us(BMP5_DELAY_US_SOFT_RESET, dev->intf_ptr);
 435:Drivers/BMP580/bmp5.c **** 
 436:Drivers/BMP580/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 437:Drivers/BMP580/bmp5.c ****         {
 438:Drivers/BMP580/bmp5.c ****             /* Performing a single read via SPI of registers,
 439:Drivers/BMP580/bmp5.c ****             * e.g. registers CHIP_ID, before the actual
 440:Drivers/BMP580/bmp5.c ****             * SPI communication with the device.
 441:Drivers/BMP580/bmp5.c ****             */
 442:Drivers/BMP580/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_CHIP_ID, &reg_data, 1, dev);
 443:Drivers/BMP580/bmp5.c ****         }
 444:Drivers/BMP580/bmp5.c **** 
 445:Drivers/BMP580/bmp5.c ****         if (rslt == BMP5_OK)
 446:Drivers/BMP580/bmp5.c ****         {
 447:Drivers/BMP580/bmp5.c ****             rslt = bmp5_get_interrupt_status(&por_status, dev);
 448:Drivers/BMP580/bmp5.c **** 
 449:Drivers/BMP580/bmp5.c ****             if (rslt == BMP5_OK)
 450:Drivers/BMP580/bmp5.c ****             {
 451:Drivers/BMP580/bmp5.c ****                 if (por_status & BMP5_INT_ASSERTED_POR_SOFTRESET_COMPLETE)
 452:Drivers/BMP580/bmp5.c ****                 {
 453:Drivers/BMP580/bmp5.c ****                     rslt = BMP5_OK;
 454:Drivers/BMP580/bmp5.c ****                 }
 455:Drivers/BMP580/bmp5.c ****                 else
 456:Drivers/BMP580/bmp5.c ****                 {
 457:Drivers/BMP580/bmp5.c ****                     rslt = BMP5_E_POR_SOFTRESET;
 458:Drivers/BMP580/bmp5.c ****                 }
 459:Drivers/BMP580/bmp5.c ****             }
 460:Drivers/BMP580/bmp5.c ****         }
 461:Drivers/BMP580/bmp5.c ****     }
 462:Drivers/BMP580/bmp5.c **** 
 463:Drivers/BMP580/bmp5.c ****     return rslt;
 464:Drivers/BMP580/bmp5.c **** }
 465:Drivers/BMP580/bmp5.c **** 
 466:Drivers/BMP580/bmp5.c **** /*!
 467:Drivers/BMP580/bmp5.c ****  *  @brief This API is used to get interrupt status.
 468:Drivers/BMP580/bmp5.c ****  */
 469:Drivers/BMP580/bmp5.c **** int8_t bmp5_get_interrupt_status(uint8_t *int_status, struct bmp5_dev *dev)
 470:Drivers/BMP580/bmp5.c **** {
 471:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 472:Drivers/BMP580/bmp5.c **** 
 473:Drivers/BMP580/bmp5.c ****     if (int_status != NULL)
 474:Drivers/BMP580/bmp5.c ****     {
 475:Drivers/BMP580/bmp5.c ****         rslt = bmp5_get_regs(BMP5_REG_INT_STATUS, int_status, 1, dev);
 476:Drivers/BMP580/bmp5.c ****     }
 477:Drivers/BMP580/bmp5.c ****     else
 478:Drivers/BMP580/bmp5.c ****     {
 479:Drivers/BMP580/bmp5.c ****         rslt = BMP5_E_NULL_PTR;
 480:Drivers/BMP580/bmp5.c ****     }
 481:Drivers/BMP580/bmp5.c **** 
 482:Drivers/BMP580/bmp5.c ****     return rslt;
 483:Drivers/BMP580/bmp5.c **** }
