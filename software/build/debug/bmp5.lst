 485:Drivers/BMP580/bmp5.c **** /*!
 486:Drivers/BMP580/bmp5.c ****  *  @brief This API is used to get powermode of the sensor.
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\ccGCFMYR.s 			page 10


 487:Drivers/BMP580/bmp5.c ****  */
 488:Drivers/BMP580/bmp5.c **** int8_t bmp5_get_power_mode(enum bmp5_powermode *powermode, struct bmp5_dev *dev)
 489:Drivers/BMP580/bmp5.c **** {
 490:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 491:Drivers/BMP580/bmp5.c ****     uint8_t deep_dis;
 492:Drivers/BMP580/bmp5.c ****     uint8_t reg_data;
 493:Drivers/BMP580/bmp5.c ****     uint8_t pwrmode;
 494:Drivers/BMP580/bmp5.c **** 
 495:Drivers/BMP580/bmp5.c ****     if (powermode != NULL)
 496:Drivers/BMP580/bmp5.c ****     {
 497:Drivers/BMP580/bmp5.c ****         /* Read the power mode register */
 498:Drivers/BMP580/bmp5.c ****         rslt = bmp5_get_regs(BMP5_REG_ODR_CONFIG, &reg_data, 1, dev);
 499:Drivers/BMP580/bmp5.c **** 
 500:Drivers/BMP580/bmp5.c ****         if (rslt == BMP5_OK)
 501:Drivers/BMP580/bmp5.c ****         {
 502:Drivers/BMP580/bmp5.c ****             pwrmode = BMP5_GET_BITS_POS_0(reg_data, BMP5_POWERMODE);
 503:Drivers/BMP580/bmp5.c **** 
 504:Drivers/BMP580/bmp5.c ****             switch (pwrmode)
 505:Drivers/BMP580/bmp5.c ****             {
 506:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_STANDBY:
 507:Drivers/BMP580/bmp5.c **** 
 508:Drivers/BMP580/bmp5.c ****                     /* Getting deep disable status */
 509:Drivers/BMP580/bmp5.c ****                     deep_dis = BMP5_GET_BITSLICE(reg_data, BMP5_DEEP_DISABLE);
 510:Drivers/BMP580/bmp5.c **** 
 511:Drivers/BMP580/bmp5.c ****                     /* Checking deepstandby status only when powermode is in standby mode */
 512:Drivers/BMP580/bmp5.c **** 
 513:Drivers/BMP580/bmp5.c ****                     /* If deep_dis = 0(BMP5_DEEP_ENABLED) then deepstandby mode is enabled.
 514:Drivers/BMP580/bmp5.c ****                      * If deep_dis = 1(BMP5_DEEP_DISABLED) then deepstandby mode is disabled
 515:Drivers/BMP580/bmp5.c ****                      */
 516:Drivers/BMP580/bmp5.c ****                     if (deep_dis == BMP5_DEEP_ENABLED)
 517:Drivers/BMP580/bmp5.c ****                     {
 518:Drivers/BMP580/bmp5.c ****                         rslt = check_deepstandby_mode(powermode, dev);
 519:Drivers/BMP580/bmp5.c ****                     }
 520:Drivers/BMP580/bmp5.c ****                     else
 521:Drivers/BMP580/bmp5.c ****                     {
 522:Drivers/BMP580/bmp5.c ****                         *powermode = BMP5_POWERMODE_STANDBY;
 523:Drivers/BMP580/bmp5.c ****                     }
 524:Drivers/BMP580/bmp5.c **** 
 525:Drivers/BMP580/bmp5.c ****                     break;
 526:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_NORMAL:
 527:Drivers/BMP580/bmp5.c ****                     *powermode = BMP5_POWERMODE_NORMAL;
 528:Drivers/BMP580/bmp5.c ****                     break;
 529:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_FORCED:
 530:Drivers/BMP580/bmp5.c ****                     *powermode = BMP5_POWERMODE_FORCED;
 531:Drivers/BMP580/bmp5.c ****                     break;
 532:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_CONTINOUS:
 533:Drivers/BMP580/bmp5.c ****                     *powermode = BMP5_POWERMODE_CONTINOUS;
 534:Drivers/BMP580/bmp5.c ****                     break;
 535:Drivers/BMP580/bmp5.c ****                 default:
 536:Drivers/BMP580/bmp5.c ****                     rslt = BMP5_E_INVALID_POWERMODE;
 537:Drivers/BMP580/bmp5.c ****                     break;
 538:Drivers/BMP580/bmp5.c ****             }
 539:Drivers/BMP580/bmp5.c ****         }
 540:Drivers/BMP580/bmp5.c ****     }
 541:Drivers/BMP580/bmp5.c ****     else
 542:Drivers/BMP580/bmp5.c ****     {
 543:Drivers/BMP580/bmp5.c ****         rslt = BMP5_E_NULL_PTR;
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\ccGCFMYR.s 			page 11


 544:Drivers/BMP580/bmp5.c ****     }
 545:Drivers/BMP580/bmp5.c **** 
 546:Drivers/BMP580/bmp5.c ****     return rslt;
 547:Drivers/BMP580/bmp5.c **** }
 548:Drivers/BMP580/bmp5.c **** 
 549:Drivers/BMP580/bmp5.c **** /*!
 550:Drivers/BMP580/bmp5.c ****  *  @brief This API is used to set powermode of the sensor.
 551:Drivers/BMP580/bmp5.c ****  */
 552:Drivers/BMP580/bmp5.c **** int8_t bmp5_set_power_mode(enum bmp5_powermode powermode, struct bmp5_dev *dev)
 553:Drivers/BMP580/bmp5.c **** {
 554:Drivers/BMP580/bmp5.c ****     int8_t rslt;
 555:Drivers/BMP580/bmp5.c ****     enum bmp5_powermode lst_pwrmode;
 556:Drivers/BMP580/bmp5.c **** 
 557:Drivers/BMP580/bmp5.c ****     /* Existing power mode of the device is received in lst_pwrmode */
 558:Drivers/BMP580/bmp5.c ****     rslt = bmp5_get_power_mode(&lst_pwrmode, dev);
 559:Drivers/BMP580/bmp5.c **** 
 560:Drivers/BMP580/bmp5.c ****     if (rslt == BMP5_OK)
 561:Drivers/BMP580/bmp5.c ****     {
 562:Drivers/BMP580/bmp5.c ****         /* If the sensor is not in standby mode set the device to
 563:Drivers/BMP580/bmp5.c ****          *  standby mode.
 564:Drivers/BMP580/bmp5.c ****          */
 565:Drivers/BMP580/bmp5.c ****         if (lst_pwrmode != BMP5_POWERMODE_STANDBY)
 566:Drivers/BMP580/bmp5.c ****         {
 567:Drivers/BMP580/bmp5.c ****             /* Device should be set to standby before transiting to
 568:Drivers/BMP580/bmp5.c ****              * forced mode or normal mode or continous mode.
 569:Drivers/BMP580/bmp5.c ****              */
 570:Drivers/BMP580/bmp5.c ****             rslt = set_power_mode(BMP5_POWERMODE_STANDBY, dev);
 571:Drivers/BMP580/bmp5.c **** 
 572:Drivers/BMP580/bmp5.c ****             if (rslt == BMP5_OK)
 573:Drivers/BMP580/bmp5.c ****             {
 574:Drivers/BMP580/bmp5.c ****                 /* Give t_standby(as per data sheet) time for device to go into standby mode */
 575:Drivers/BMP580/bmp5.c ****                 dev->delay_us(BMP5_DELAY_US_STANDBY, dev->intf_ptr);
 576:Drivers/BMP580/bmp5.c ****             }
 577:Drivers/BMP580/bmp5.c ****         }
 578:Drivers/BMP580/bmp5.c **** 
 579:Drivers/BMP580/bmp5.c ****         /* Set the desired power mode */
 580:Drivers/BMP580/bmp5.c ****         if (rslt == BMP5_OK)
 581:Drivers/BMP580/bmp5.c ****         {
 582:Drivers/BMP580/bmp5.c ****             switch (powermode)
 583:Drivers/BMP580/bmp5.c ****             {
 584:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_DEEP_STANDBY:
 585:Drivers/BMP580/bmp5.c ****                     rslt = set_deep_standby_mode(dev);
 586:Drivers/BMP580/bmp5.c ****                     break;
 587:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_STANDBY:
 588:Drivers/BMP580/bmp5.c **** 
 589:Drivers/BMP580/bmp5.c ****                     /* Since switching between powermodes require sensor to be in standby mode
 590:Drivers/BMP580/bmp5.c ****                      * it is performed above. So it is not explicitly performed here.
 591:Drivers/BMP580/bmp5.c ****                      */
 592:Drivers/BMP580/bmp5.c ****                     break;
 593:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_NORMAL:
 594:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_FORCED:
 595:Drivers/BMP580/bmp5.c ****                 case BMP5_POWERMODE_CONTINOUS:
 596:Drivers/BMP580/bmp5.c ****                     rslt = set_power_mode(powermode, dev);
