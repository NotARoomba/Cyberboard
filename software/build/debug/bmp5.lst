1569:Drivers/BMP580/bmp5.c **** 
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\ccGCFMYR.s 			page 31


1570:Drivers/BMP580/bmp5.c ****                 /* The register holds only iir_t and iir_p and the last 2 bits are reserved.
