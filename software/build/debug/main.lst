 115:Core/Src/main.c ****   /* Give USB time to enumerate before any CDC transmits */
 116:Core/Src/main.c ****   HAL_Delay(2000);
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****   /* I2C bus scan – report every device that ACKs */
 119:Core/Src/main.c ****   {
 120:Core/Src/main.c ****     int len = snprintf(serial_buf, sizeof(serial_buf), "I2C scan:\r\n");
 121:Core/Src/main.c ****     CDC_Transmit_FS((uint8_t *)serial_buf, len);
 122:Core/Src/main.c ****     HAL_Delay(10);
 123:Core/Src/main.c ****     uint8_t found = 0;
 124:Core/Src/main.c ****     for (uint8_t addr = 0x08; addr < 0x78; addr++) {
 125:Core/Src/main.c ****       if (HAL_I2C_IsDeviceReady(&hi2c1, (uint16_t)(addr << 1), 2, 10) == HAL_OK) {
 126:Core/Src/main.c ****         len = snprintf(serial_buf, sizeof(serial_buf), "  0x%02X ACK\r\n", addr);
 127:Core/Src/main.c ****         CDC_Transmit_FS((uint8_t *)serial_buf, len);
 128:Core/Src/main.c ****         HAL_Delay(10);
 129:Core/Src/main.c ****         found++;
 130:Core/Src/main.c ****       }
 131:Core/Src/main.c ****     }
 132:Core/Src/main.c ****     if (found == 0) {
 133:Core/Src/main.c ****       len = snprintf(serial_buf, sizeof(serial_buf), "  No devices found!\r\n");
 134:Core/Src/main.c ****       CDC_Transmit_FS((uint8_t *)serial_buf, len);
 135:Core/Src/main.c ****       HAL_Delay(10);
 136:Core/Src/main.c ****     }
 137:Core/Src/main.c ****     len = snprintf(serial_buf, sizeof(serial_buf), "I2C scan done (%d found)\r\n", found);
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\cc0ip3dT.s 			page 4


 138:Core/Src/main.c ****     CDC_Transmit_FS((uint8_t *)serial_buf, len);
 139:Core/Src/main.c ****     HAL_Delay(10);
 140:Core/Src/main.c ****   }
 141:Core/Src/main.c **** 
 142:Core/Src/main.c ****   /* BMP580 barometric pressure sensor setup */
 143:Core/Src/main.c ****   int8_t bmp_err = BMP580_Setup();
 144:Core/Src/main.c ****   if (bmp_err != BMP5_OK) {
 145:Core/Src/main.c ****     while (1) {
