 430:Core/Src/main.c **** 
 431:Core/Src/main.c ****   /* Send soft-reset command manually. Do NOT call bmp5_soft_reset() because
 432:Core/Src/main.c ****    * it reads INT_STATUS (clearing the POR bit) which bmp5_init() also needs.
 433:Core/Src/main.c ****    * Instead, write the reset command, wait, and let bmp5_init() consume the
 434:Core/Src/main.c ****    * POR bit itself. */
 435:Core/Src/main.c ****   {
 436:Core/Src/main.c ****     uint8_t rst_cmd = 0xB6;  /* BMP5_SOFT_RESET_CMD */
 437:Core/Src/main.c ****     rslt = bmp5_set_regs(0x7E /* BMP5_REG_CMD */, &rst_cmd, 1, &bmp5);
 438:Core/Src/main.c ****     bmp_log("manual_reset_cmd", rslt);
 439:Core/Src/main.c ****     if (rslt != BMP5_OK) return rslt;
 440:Core/Src/main.c ****     HAL_Delay(5);  /* datasheet: 2 ms reset time, add margin */
 441:Core/Src/main.c ****   }
 442:Core/Src/main.c **** 
 443:Core/Src/main.c ****   /* Chip-level init with retry – gives the sensor time to come back */
 444:Core/Src/main.c ****   for (int attempt = 0; attempt < 3; attempt++) {
 445:Core/Src/main.c ****     rslt = bmp5_init(&bmp5);
 446:Core/Src/main.c ****     bmp_log("bmp5_init", rslt);
 447:Core/Src/main.c ****     if (rslt == BMP5_OK) break;
 448:Core/Src/main.c ****     HAL_Delay(10);
 449:Core/Src/main.c ****   }
 450:Core/Src/main.c ****   if (rslt != BMP5_OK) return rslt;
 451:Core/Src/main.c **** 
 452:Core/Src/main.c ****   /* --- Configure OSR / ODR / pressure enable --- */
 453:Core/Src/main.c ****   rslt = bmp5_set_power_mode(BMP5_POWERMODE_STANDBY, &bmp5);
 454:Core/Src/main.c ****   bmp_log("set_power_standby", rslt);
 455:Core/Src/main.c ****   if (rslt != BMP5_OK) return rslt;
 456:Core/Src/main.c **** 
 457:Core/Src/main.c ****   rslt = bmp5_get_osr_odr_press_config(&bmp5_osr_cfg, &bmp5);
 458:Core/Src/main.c ****   bmp_log("get_osr_odr_cfg", rslt);
 459:Core/Src/main.c ****   if (rslt != BMP5_OK) return rslt;
 460:Core/Src/main.c **** 
 461:Core/Src/main.c ****   bmp5_osr_cfg.odr      = BMP5_ODR_50_HZ;
 462:Core/Src/main.c ****   bmp5_osr_cfg.press_en = BMP5_ENABLE;
 463:Core/Src/main.c ****   bmp5_osr_cfg.osr_t    = BMP5_OVERSAMPLING_64X;
 464:Core/Src/main.c ****   bmp5_osr_cfg.osr_p    = BMP5_OVERSAMPLING_4X;
 465:Core/Src/main.c **** 
 466:Core/Src/main.c ****   rslt = bmp5_set_osr_odr_press_config(&bmp5_osr_cfg, &bmp5);
 467:Core/Src/main.c ****   bmp_log("set_osr_odr_cfg", rslt);
 468:Core/Src/main.c ****   if (rslt != BMP5_OK) return rslt;
 469:Core/Src/main.c **** 
 470:Core/Src/main.c ****   /* --- IIR filter --- */
 471:Core/Src/main.c ****   struct bmp5_iir_config iir_cfg;
 472:Core/Src/main.c ****   iir_cfg.set_iir_t     = BMP5_IIR_FILTER_COEFF_1;
