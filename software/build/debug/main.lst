 147:Core/Src/main.c ****                          "BMP580 init error: %d\r\n", bmp_err);
 148:Core/Src/main.c ****       CDC_Transmit_FS((uint8_t *)serial_buf, len);
 149:Core/Src/main.c ****       HAL_Delay(10);
 150:Core/Src/main.c ****       for (int i = 0; i < (-bmp_err); i++) {
 151:Core/Src/main.c ****         HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_RESET);
 152:Core/Src/main.c ****         HAL_Delay(100);
 153:Core/Src/main.c ****         HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_SET);
 154:Core/Src/main.c ****         HAL_Delay(100);
 155:Core/Src/main.c ****       }
 156:Core/Src/main.c ****       HAL_Delay(1500);
 157:Core/Src/main.c ****     }
 158:Core/Src/main.c ****   }
 159:Core/Src/main.c ****   /* USER CODE END 2 */
 160:Core/Src/main.c **** 
 161:Core/Src/main.c ****   /* Infinite loop */
