 348:Core/Src/main.c **** 
 349:Core/Src/main.c ****   /* Send soft-reset command manually. Do NOT call bmp5_soft_reset() because
 350:Core/Src/main.c ****    * it reads INT_STATUS (clearing the POR bit) which bmp5_init() also needs.
 351:Core/Src/main.c ****    * Instead, write the reset command, wait, and let bmp5_init() consume the
 352:Core/Src/main.c ****    * POR bit itself. */
 353:Core/Src/main.c ****   {
 354:Core/Src/main.c ****     uint8_t rst_cmd = 0xB6;  /* BMP5_SOFT_RESET_CMD */
 355:Core/Src/main.c ****     rslt = bmp5_set_regs(0x7E /* BMP5_REG_CMD */, &rst_cmd, 1, &bmp5);
 356:Core/Src/main.c ****     bmp_log("manual_reset_cmd", rslt);
 357:Core/Src/main.c ****     if (rslt != BMP5_OK) return rslt;
 358:Core/Src/main.c ****     HAL_Delay(5);  /* datasheet: 2 ms reset time, add margin */
 359:Core/Src/main.c ****   }
 360:Core/Src/main.c **** 
 361:Core/Src/main.c ****   /* Chip-level init with retry – gives the sensor time to come back */
 362:Core/Src/main.c ****   for (int attempt = 0; attempt < 3; attempt++) {
 363:Core/Src/main.c ****     rslt = bmp5_init(&bmp5);
 364:Core/Src/main.c ****     bmp_log("bmp5_init", rslt);
 365:Core/Src/main.c ****     if (rslt == BMP5_OK) break;
 366:Core/Src/main.c ****     HAL_Delay(10);
 367:Core/Src/main.c ****   }
 368:Core/Src/main.c ****   if (rslt != BMP5_OK) return rslt;
 369:Core/Src/main.c **** 
 370:Core/Src/main.c ****   /* --- Configure OSR / ODR / pressure enable --- */
 371:Core/Src/main.c ****   rslt = bmp5_set_power_mode(BMP5_POWERMODE_STANDBY, &bmp5);
 372:Core/Src/main.c ****   bmp_log("set_power_standby", rslt);
 373:Core/Src/main.c ****   if (rslt != BMP5_OK) return rslt;
 374:Core/Src/main.c **** 
 375:Core/Src/main.c ****   rslt = bmp5_get_osr_odr_press_config(&bmp5_osr_cfg, &bmp5);
 376:Core/Src/main.c ****   bmp_log("get_osr_odr_cfg", rslt);
 377:Core/Src/main.c ****   if (rslt != BMP5_OK) return rslt;
 378:Core/Src/main.c **** 
 379:Core/Src/main.c ****   bmp5_osr_cfg.odr      = BMP5_ODR_50_HZ;
 380:Core/Src/main.c ****   bmp5_osr_cfg.press_en = BMP5_ENABLE;
 381:Core/Src/main.c ****   bmp5_osr_cfg.osr_t    = BMP5_OVERSAMPLING_64X;
 382:Core/Src/main.c ****   bmp5_osr_cfg.osr_p    = BMP5_OVERSAMPLING_4X;
 383:Core/Src/main.c **** 
