 167:Core/Src/main.c **** 
 168:Core/Src/main.c ****     /* BMP580 – read pressure & temperature (normal mode, DRDY polling) */
 169:Core/Src/main.c ****     {
 170:Core/Src/main.c ****       uint8_t int_status = 0;
 171:Core/Src/main.c ****       if (bmp5_get_interrupt_status(&int_status, &bmp5) == BMP5_OK) {
 172:Core/Src/main.c ****         if (int_status & BMP5_INT_ASSERTED_DRDY) {
 173:Core/Src/main.c ****           if (bmp5_get_sensor_data(&bmp5_data, &bmp5_osr_cfg, &bmp5) == BMP5_OK) {
