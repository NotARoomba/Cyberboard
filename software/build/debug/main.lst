 112:Core/Src/main.c ****   /* Give USB time to enumerate before any CDC transmits */
 113:Core/Src/main.c ****   HAL_Delay(2000);
 114:Core/Src/main.c **** 
 115:Core/Src/main.c ****   /* I2C bus scan – report every device that ACKs */
 116:Core/Src/main.c ****   {
 117:Core/Src/main.c ****     int len = snprintf(serial_buf, sizeof(serial_buf), "I2C scan:\r\n");
 118:Core/Src/main.c ****     CDC_Transmit_FS((uint8_t *)serial_buf, len);
 119:Core/Src/main.c ****     HAL_Delay(10);
 120:Core/Src/main.c ****     uint8_t found = 0;
 121:Core/Src/main.c ****     for (uint8_t addr = 0x08; addr < 0x78; addr++) {
 122:Core/Src/main.c ****       if (HAL_I2C_IsDeviceReady(&hi2c1, (uint16_t)(addr << 1), 2, 10) == HAL_OK) {
 123:Core/Src/main.c ****         len = snprintf(serial_buf, sizeof(serial_buf), "  0x%02X ACK\r\n", addr);
 124:Core/Src/main.c ****         CDC_Transmit_FS((uint8_t *)serial_buf, len);
 125:Core/Src/main.c ****         HAL_Delay(10);
 126:Core/Src/main.c ****         found++;
 127:Core/Src/main.c ****       }
 128:Core/Src/main.c ****     }
 129:Core/Src/main.c ****     if (found == 0) {
 130:Core/Src/main.c ****       len = snprintf(serial_buf, sizeof(serial_buf), "  No devices found!\r\n");
 131:Core/Src/main.c ****       CDC_Transmit_FS((uint8_t *)serial_buf, len);
 132:Core/Src/main.c ****       HAL_Delay(10);
 133:Core/Src/main.c ****     }
 134:Core/Src/main.c ****     len = snprintf(serial_buf, sizeof(serial_buf), "I2C scan done (%d found)\r\n", found);
 135:Core/Src/main.c ****     CDC_Transmit_FS((uint8_t *)serial_buf, len);
 136:Core/Src/main.c ****     HAL_Delay(10);
 137:Core/Src/main.c ****   }
