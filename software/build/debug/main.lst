 143:Core/Src/main.c **** 
 144:Core/Src/main.c ****   /* Raw SPI diagnostic — bypass driver, read WHO_AM_I manually */
 145:Core/Src/main.c ****   {
 146:Core/Src/main.c ****     uint8_t tx[2] = { 0x75 | 0x80, 0x00 };  /* read reg 0x75 */
 147:Core/Src/main.c ****     uint8_t rx[2] = { 0xFF, 0xFF };
 148:Core/Src/main.c ****     HAL_GPIO_WritePin(ICM_CS_GPIO_Port, ICM_CS_Pin, GPIO_PIN_RESET);
 149:Core/Src/main.c ****     HAL_StatusTypeDef st = HAL_SPI_TransmitReceive(&hspi1, tx, rx, 2, 100);
 150:Core/Src/main.c ****     HAL_GPIO_WritePin(ICM_CS_GPIO_Port, ICM_CS_Pin, GPIO_PIN_SET);
 151:Core/Src/main.c ****     int len = snprintf(serial_buf, sizeof(serial_buf),
 152:Core/Src/main.c ****                        "SPI raw: HAL=%d  tx={0x%02X,0x%02X}  rx={0x%02X,0x%02X}\r\n",
 153:Core/Src/main.c ****                        st, tx[0], tx[1], rx[0], rx[1]);
 154:Core/Src/main.c ****     CDC_Transmit_FS((uint8_t *)serial_buf, len);
 155:Core/Src/main.c ****     HAL_Delay(10);
 156:Core/Src/main.c **** 
 157:Core/Src/main.c ****     /* Also check MISO pin state with CS asserted (should not be stuck) */
 158:Core/Src/main.c ****     HAL_GPIO_WritePin(ICM_CS_GPIO_Port, ICM_CS_Pin, GPIO_PIN_RESET);
 159:Core/Src/main.c ****     HAL_Delay(1);
 160:Core/Src/main.c ****     GPIO_PinState miso = HAL_GPIO_ReadPin(ICM_MISO_GPIO_Port, ICM_MISO_Pin);
 161:Core/Src/main.c ****     HAL_GPIO_WritePin(ICM_CS_GPIO_Port, ICM_CS_Pin, GPIO_PIN_SET);
 162:Core/Src/main.c ****     len = snprintf(serial_buf, sizeof(serial_buf),
 163:Core/Src/main.c ****                    "MISO pin state (CS low): %d\r\n", miso);
 164:Core/Src/main.c ****     CDC_Transmit_FS((uint8_t *)serial_buf, len);
 165:Core/Src/main.c ****     HAL_Delay(10);
 166:Core/Src/main.c ****   }
 167:Core/Src/main.c **** 
 168:Core/Src/main.c ****   int icm_err = ICM42688_Init(&icm);
