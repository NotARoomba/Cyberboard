 176:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h **** /**
 177:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * @brief ACI_GAP_RESOLVE_PRIVATE_ADDR
 178:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * This command tries to resolve the address provided with the IRKs present in
 179:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * its database. If the address is resolved successfully with any one of the
 180:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * IRKs present in the database, it returns success and also the corresponding
 181:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * public/static random address stored with the IRK in the database.
 182:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  *
 183:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * @param Address Address to be resolved
 184:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * @param[out] Actual_Address The public or static random address of the peer
 185:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  *        device, distributed during pairing phase.
 186:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * @return Value indicating success or error code.
 187:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  */
 188:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h **** __STATIC_INLINE
 189:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h **** tBleStatus aci_gap_resolve_private_addr( const uint8_t* Address,
 190:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****                                          uint8_t* Actual_Address )
 191:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h **** {
 192:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****   uint8_t type;
 193:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****   return aci_gap_check_bonded_device( 1, Address, &type, Actual_Address );
 194:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h **** }
 195:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h **** 
 196:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h **** /**
 197:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * @brief ACI_GAP_IS_DEVICE_BONDED
 198:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * The command finds whether the device, whose address is specified in the
 199:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * command, is present in the bonding table. If the device is found, the
 200:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * command returns "Success".
ARM GAS  C:\Users\Nathan\AppData\Local\Temp\cc7slxkI.s 			page 5


 201:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * Note: the specified address can be a RPA. In this case, even if privacy is
 202:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * not enabled, this address is resolved to check the presence of the peer
 203:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * device in the bonding table.
 204:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  *
 205:Middlewares/ST/STM32_WPAN/ble/core/ble_legacy.h ****  * @param Peer_Address_Type The address type of the peer device.
